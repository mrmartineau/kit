{
  "name": "@mrmartineau/kit",
  "version": "1.0.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/bun": "1.3.14",
    "@types/eslint": "^9.6.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "semantic-release": "^25.0.9"
  },
  "peerDependencies": {
    "eslint": "*",
    "prettier": "^3.0.0",
    "prettier-plugin-astro": "^0.14.0",
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": "./src/index.ts",
    "./biome": "./src/biome/biome.json",
    "./components": "./src/components/index.ts",
    "./eslint": "./src/eslint/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./oxfmt": "./src/oxfmt/.oxfmtrc.json",
    "./oxlint": "./src/oxlint/.oxlintrc.json",
    "./prettier": "./src/prettier/.prettierrc.json",
    "./prettier/astro": "./src/prettier/astro.js",
    "./sounds": "./src/sounds/index.ts",
    "./sounds/*": "./src/sounds/*",
    "./utils": "./src/utils/index.ts"
  },
  "files": [
    "src"
  ],
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "prettier-plugin-astro": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "ci:lint": "biome ci .",
    "release": "semantic-release"
  },
  "type": "module"
}
